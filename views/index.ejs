<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="./style.css">
</head>

<body>

    <h1>QUORA POST</h1>
    <%for(post of posts) {%>
        <div class="post">
            <h3 class="user">username: @<%= post.username%>
            </h3>
            <h4 class="content">Content: <%= post.Content%>
            </h4>
        </div>

        <%}%>
</body>
  
</html>