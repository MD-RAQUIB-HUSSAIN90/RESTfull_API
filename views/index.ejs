<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="./style.css">
</head>

<body>

    <h1 class="QuoraPost">QUORA POST</h1>
    <%for(post of posts) {%>
        <div class="post">
            <h3 class="user">username: @<%= post.username%>
            </h3>
            <h4 class="content">Content: <%= post.content%>
            </h4>
            <br>
            <a href="http://localhost:8080/posts/<%=post.id%>">See in details</a>
            <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit</a>
            
        </div>
        <%}%>


            <br>
            <br>
            <br>
            <a href="http://localhost:8080/posts/new"> Create New Post</a>
</body>

</html>